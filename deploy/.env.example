# Copy to .env next to docker-compose.yml on the host (never commit it).
# Shared secret between lobby and coturn: openssl rand -hex 32
TURN_SECRET=
# Cloudflare API token with Zone / DNS / Edit on r4b2.de, for the lobby's TLS certificate.
CF_API_TOKEN=
# VictoriaMetrics remote-write login (the same one gvm's vector uses).
VM_USER=
VM_PASSWORD=
