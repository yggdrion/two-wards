[gd_resource type="Resource" script_class="UpgradeData" format=3]

[ext_resource type="Script" path="res://scripts/data/upgrade_data.gd" id="1_upgrade"]

[resource]
script = ExtResource("1_upgrade")
id = &"twin_shot"
display_name = "Twin Shot"
rarity = 2
text = "Each attack fires one more shot at another goblin."
requires = {"fire_interval": 0.0}
excludes = Array[StringName]([&"area"])
adds = {"shots": 1}
